# Settings for one deployment of docker-compose.yml. Copy this file to .env
# beside it and fill in what this machine needs; .env is not committed, so a
# `git pull` never touches it. Unset lines keep the default shown.
#
# Compose reads .env only to fill in the ${...} placeholders of
# docker-compose.yml, and every one of them is listed here. Any other variable
# put here does not reach the containers.

# Memory one metric run may use, e.g. 64G (binary units). No default: unset,
# MAST runs on any pair, and one too large for the machine gets the worker
# killed. Size it from `free -h` with the stack running (DECISIONS §50).
#PHYLODELTA_METRIC_MEMORY=

# Host ports: the app, and the API for use without the app.
#PHYLODELTA_WEB_PORT=3001
#PHYLODELTA_PORT=8001

# Authentication: mock (one user, nothing checked), header, or jwt. jwt needs
# the settings below; without them the service refuses to start, naming what
# is missing. See docs/api-integration.md §1.
#PHYLODELTA_AUTH=mock

# For jwt: the token issuer (iss) and this service's audience (aud), both
# required, and either a JWKS URL (RS256, from an identity provider) or a
# shared secret of at least 32 bytes (HS256, which also needs ALGORITHMS).
# Kept here rather than in docker-compose.yml so a secret never enters git.
#PHYLODELTA_JWT_ISSUER=
#PHYLODELTA_JWT_AUDIENCE=
#PHYLODELTA_JWT_JWKS_URL=
#PHYLODELTA_JWT_SECRET=
# Accepted algorithms, comma-separated. Unset or empty means RS256.
#PHYLODELTA_JWT_ALGORITHMS=

# Origins the API accepts browser requests from. Narrow it to the app's origin
# once known; the app itself goes through its own proxy and does not need it.
#PHYLODELTA_CORS_ORIGINS=*
