{
  "name": "theses-code",
  "private": true,
  "description": "Workspace root: the phylo-tree-viewer library, the PhyloDelta web app and the benchmark harness.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "lib",
    "web",
    "bench"
  ],
  "scripts": {
    "start": "npm start --workspace web",
    "build": "npm run build --workspace web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "preview": "npm run preview --workspace web"
  }
}
